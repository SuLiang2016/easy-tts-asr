# 火山引擎语音服务配置
# 新版控制台 API Key (从 https://console.volcengine.com/speech/new/setting/apikeys 获取)
VOLC_API_KEY=your_api_key_here

# TTS 配置
VOLC_TTS_APP_ID=your_app_id
VOLC_TTS_ACCESS_TOKEN=your_access_token
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_RESOURCE_ID=volc.service_type.10029

# ASR 配置
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
