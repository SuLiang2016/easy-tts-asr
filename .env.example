# 火山引擎语音服务配置
# Agent Plan 专属 API Key
VOLC_API_KEY=your_agent_plan_api_key_here

# TTS HTTP 一次性合成配置
VOLC_TTS_HTTP_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
VOLC_TTS_RESOURCE_ID=seed-tts-2.0

# ASR WebSocket 单流识别（Agent Plan 端点，/plan/ 体系，配合 ark- 开头的 API Key）
# 注意：ark- Agent Plan Key 只支持 /plan/ 前缀端点 + seedasr/seed- 系列 Resource ID。
# 非 /plan/ 前缀的普通火山语音端点（如 /auc/bigmodel/recognize/flash + volc.bigasr.*）需另一类 Key，会返回 401/403。
VOLC_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_nostream
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
